# 이 파일을 .env.local로 복사해 값을 바꾼다 (.env.local은 git에 올라가지 않는다).
# 자세한 내용: docs/mock-server.md

# 실제 백엔드 주소. 비워 두면 모의 서버(mock/)가 /api/v1을 응답한다.
# 값을 넣으면 모의 서버를 끄고 /api를 이 주소로 넘긴다 (WebSocket 포함).
API_TARGET=

# Vercel Production의 공개 백엔드 HTTPS 출처. 경로 없이 주소만 넣는다.
VITE_PUBLIC_BACKEND_ORIGIN=

# 모의 서버의 액세스 토큰 유효 시간(초). 기본 3600. 재발급 흐름을 검수할 때 30 정도로 줄인다.
MOCK_ACCESS_TTL_SEC=
